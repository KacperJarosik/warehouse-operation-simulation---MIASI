<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:message id="Message_NewOrder" name="Message_NewOrder" />
  <bpmn:message id="Message_Payment" name="Message_Payment" />
  <bpmn:collaboration id="Collaboration_164l1vl">
    <bpmn:participant id="Participant_0rxtqax" processRef="Process_OrderTransport" />
    <bpmn:participant id="Participant_02ci955" name="klient" processRef="Process_1yjnjb7">
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:messageFlow id="Flow_0k6k6zf" sourceRef="Participant_02ci955" targetRef="StartEvent_OrderReceived" />
    <bpmn:messageFlow id="Flow_12rcqwn" sourceRef="Participant_02ci955" targetRef="Event_PaymentReceived" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OrderTransport" name="Zamówienia i Transporty" isExecutable="true">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Zamówienie otrzymane">
      <bpmn:outgoing>Flow_ToRegister</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Order" messageRef="Message_NewOrder" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RegisterOrder" name="Rejestracja zamówienia" camunda:type="external" camunda:topic="register-order">
      <bpmn:incoming>Flow_ToRegister</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCheckStock</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckStock" name="Sprawdzenie dostępności na magazynie" camunda:type="external" camunda:topic="check-stock">
      <bpmn:incoming>Flow_ToCheckStock</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStockGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Czy wszystkie towary dostępne?">
      <bpmn:incoming>Flow_ToStockGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AllInStock</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotAllInStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DefineDeliveryTime" name="Określenie czasu dostawy&#10;(data wyjazdu, data dostarczenia)" camunda:type="external" camunda:topic="define-delivery-time">
      <bpmn:incoming>Flow_AllInStock</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliveryToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StartProduction" name="Rozpoczęcie produkcji brakujących towarów" camunda:type="external" camunda:topic="start-production">
      <bpmn:incoming>Flow_NotAllInStock</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEstimateDate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_EstimateTransportDate" name="Szacowanie daty transportu&#10;(data wyjazdu, data dostarczenia)" camunda:type="external" camunda:topic="estimate-transport-date">
      <bpmn:incoming>Flow_ToEstimateDate</bpmn:incoming>
      <bpmn:outgoing>Flow_EstimateToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Merge" name="Scalenie ścieżek">
      <bpmn:incoming>Flow_DeliveryToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_EstimateToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCalculatePrice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CalculatePrice" name="Wycena zamówienia&#10;(produkty + transport)" camunda:type="external" camunda:topic="calculate-price">
      <bpmn:incoming>Flow_ToCalculatePrice</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendQuote</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendQuote" name="Wysłanie wyceny do klienta" camunda:type="external" camunda:topic="send-quote">
      <bpmn:incoming>Flow_ToSendQuote</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEventGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_EventBased" name="Oczekiwanie na płatność">
      <bpmn:incoming>Flow_ToEventGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTimerEvent</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToPaymentMessage</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_PaymentReceived" name="Płatność otrzymana">
      <bpmn:incoming>Flow_ToPaymentMessage</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaymentCheck</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Payment" messageRef="Message_Payment" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_PaymentValid" name="Czy płatność prawidłowa?">
      <bpmn:incoming>Flow_ToPaymentCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CancelInvalidPayment" name="Anulowanie przygotowań&#10;(płatność nieprawidłowa)" camunda:type="external" camunda:topic="cancel-order">
      <bpmn:incoming>Flow_PaymentInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndCancelPayment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Success" name="Zamówienie zrealizowane">
      <bpmn:incoming>Flow_ToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_CancelPayment" name="Zamówienie anulowane&#10;(płatność)">
      <bpmn:incoming>Flow_ToEndCancelPayment</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_PrepareShipment" name="Przygotowanie przesyłki" camunda:type="external" camunda:topic="prepare-shipment">
      <bpmn:incoming>Flow_PaymentValid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToShip</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ShipOrder" name="Wysyłka zamówienia" camunda:type="external" camunda:topic="ship-order">
      <bpmn:incoming>Flow_ToShip</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyDelivery</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyDelivery" name="Powiadomienie klienta o wysyłce" camunda:type="external" camunda:topic="notify-delivery">
      <bpmn:incoming>Flow_ToNotifyDelivery</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_Timer" name="Termin upłynął&#10;(data transportu)">
      <bpmn:incoming>Flow_ToTimerEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerToCancel</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_Deadline">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${estimatedTransportDate}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_CancelTimeout" name="Anulowanie zamówienia&#10;(brak płatności w terminie)" camunda:type="external" camunda:topic="cancel-order">
      <bpmn:incoming>Flow_TimerToCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndCancelTimeout</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_CancelTimeout" name="Zamówienie anulowane&#10;(timeout)">
      <bpmn:incoming>Flow_ToEndCancelTimeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToRegister" sourceRef="StartEvent_OrderReceived" targetRef="Task_RegisterOrder" />
    <bpmn:sequenceFlow id="Flow_ToCheckStock" sourceRef="Task_RegisterOrder" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="Flow_ToStockGateway" sourceRef="Task_CheckStock" targetRef="Gateway_StockCheck" />
    <bpmn:sequenceFlow id="Flow_AllInStock" name="Tak" sourceRef="Gateway_StockCheck" targetRef="Task_DefineDeliveryTime">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allItemsInStock == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotAllInStock" name="Nie" sourceRef="Gateway_StockCheck" targetRef="Task_StartProduction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allItemsInStock == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DeliveryToMerge" sourceRef="Task_DefineDeliveryTime" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToEstimateDate" sourceRef="Task_StartProduction" targetRef="Task_EstimateTransportDate" />
    <bpmn:sequenceFlow id="Flow_EstimateToMerge" sourceRef="Task_EstimateTransportDate" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToCalculatePrice" sourceRef="Gateway_Merge" targetRef="Task_CalculatePrice" />
    <bpmn:sequenceFlow id="Flow_ToSendQuote" sourceRef="Task_CalculatePrice" targetRef="Task_SendQuote" />
    <bpmn:sequenceFlow id="Flow_ToEventGateway" sourceRef="Task_SendQuote" targetRef="Gateway_EventBased" />
    <bpmn:sequenceFlow id="Flow_ToTimerEvent" sourceRef="Gateway_EventBased" targetRef="Event_Timer" />
    <bpmn:sequenceFlow id="Flow_ToPaymentMessage" sourceRef="Gateway_EventBased" targetRef="Event_PaymentReceived" />
    <bpmn:sequenceFlow id="Flow_ToPaymentCheck" sourceRef="Event_PaymentReceived" targetRef="Gateway_PaymentValid" />
    <bpmn:sequenceFlow id="Flow_PaymentValid" name="Tak" sourceRef="Gateway_PaymentValid" targetRef="Task_PrepareShipment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentInvalid" name="Nie" sourceRef="Gateway_PaymentValid" targetRef="Task_CancelInvalidPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentValid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToEndCancelPayment" sourceRef="Task_CancelInvalidPayment" targetRef="EndEvent_CancelPayment" />
    <bpmn:sequenceFlow id="Flow_ToEndSuccess" sourceRef="Task_NotifyDelivery" targetRef="EndEvent_Success" />
    <bpmn:sequenceFlow id="Flow_ToShip" sourceRef="Task_PrepareShipment" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_ToNotifyDelivery" sourceRef="Task_ShipOrder" targetRef="Task_NotifyDelivery" />
    <bpmn:sequenceFlow id="Flow_TimerToCancel" sourceRef="Event_Timer" targetRef="Task_CancelTimeout" />
    <bpmn:sequenceFlow id="Flow_ToEndCancelTimeout" sourceRef="Task_CancelTimeout" targetRef="EndEvent_CancelTimeout" />
  </bpmn:process>
