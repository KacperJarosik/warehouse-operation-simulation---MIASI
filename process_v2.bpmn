<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:message id="Message_NewOrder" name="Message_NewOrder" />
  <bpmn:message id="Message_Payment" name="Message_Payment" />
  <bpmn:error id="Error_ShipmentFailed" name="Error_ShipmentFailed" errorCode="SHIPMENT_ERR" />
  <bpmn:error id="Error_PreparationFailed" name="Error_PreparationFailed" errorCode="PREPARATION_ERR" />
  <bpmn:collaboration id="Collaboration_164l1vl">
    <bpmn:participant id="Participant_02ci955" name="klient" processRef="Process_1yjnjb7">
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:participant id="Participant_0rxtqax" processRef="Process_OrderTransport" />
    <bpmn:messageFlow id="Flow_12rcqwn" sourceRef="Participant_02ci955" targetRef="Event_PaymentReceived" />
    <bpmn:messageFlow id="Flow_0k6k6zf" sourceRef="Participant_02ci955" targetRef="StartEvent_OrderReceived" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1yjnjb7" isExecutable="false" />
  <bpmn:process id="Process_OrderTransport" name="Zamówienia i Transporty" isExecutable="true">
    <bpmn:transaction id="Transaction_Shipment" name="Transakcja wysyłki">
      <bpmn:incoming>Flow_PaymentValid</bpmn:incoming>
      <bpmn:outgoing>Flow_TransactionToNotify</bpmn:outgoing>
      <bpmn:endEvent id="CancelEnd_Transaction" name="Anulowanie transakcji&#10;(cofnięcie zadań)">
        <bpmn:incoming>Flow_TxShipFailed</bpmn:incoming>
        <bpmn:cancelEventDefinition id="CancelEndDef_Tx" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="Task_UndoPrepare" name="Cofnięcie przygotowania przesyłki" isForCompensation="true" flowable:type="external" flowable:topic="undo-prepare-shipment" />
      <bpmn:serviceTask id="Task_UndoShip" name="Cofnięcie wysyłki zamówienia" isForCompensation="true" flowable:type="external" flowable:topic="undo-ship-order" />
      <bpmn:endEvent id="End_Transaction" name="Transakcja zakończona pomyślnie">
        <bpmn:incoming>Flow_TxToEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="Task_ConfirmShipment" name="Potwierdzenie wysyłki" flowable:formKey="confirmShipmentForm" flowable:candidateGroups="warehouse">
        <bpmn:incoming>Flow_TxShipOk</bpmn:incoming>
        <bpmn:outgoing>Flow_TxToEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_TxToEnd" sourceRef="Task_ConfirmShipment" targetRef="End_Transaction" />
      <bpmn:exclusiveGateway id="Gateway_ShipmentOk" name="Czy wysyłka poprawna?">
        <bpmn:incoming>Flow_TxToGateway</bpmn:incoming>
        <bpmn:outgoing>Flow_TxShipFailed</bpmn:outgoing>
        <bpmn:outgoing>Flow_TxShipOk</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_TxShipFailed" name="Nie" sourceRef="Gateway_ShipmentOk" targetRef="CancelEnd_Transaction">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${shipmentValid == false}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_TxShipOk" name="Tak" sourceRef="Gateway_ShipmentOk" targetRef="Task_ConfirmShipment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${shipmentValid == true}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:serviceTask id="Task_ShipOrder" name="Wysyłka zamówienia" flowable:type="external" flowable:topic="ship-order">
        <bpmn:incoming>Flow_TxToShip</bpmn:incoming>
        <bpmn:outgoing>Flow_TxToGateway</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_TxToGateway" sourceRef="Task_ShipOrder" targetRef="Gateway_ShipmentOk" />
      <bpmn:boundaryEvent id="BoundaryCompensation_Ship" name="Kompensacja wysyłki" attachedToRef="Task_ShipOrder">
        <bpmn:compensateEventDefinition id="CompensateDef_Ship" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="Task_PrepareShipment" name="Przygotowanie przesyłki" flowable:type="external" flowable:topic="prepare-shipment">
        <bpmn:incoming>Flow_TxToPrepare</bpmn:incoming>
        <bpmn:outgoing>Flow_TxToShip</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_TxToShip" sourceRef="Task_PrepareShipment" targetRef="Task_ShipOrder" />
      <bpmn:boundaryEvent id="BoundaryCompensation_Prepare" name="Kompensacja przygotowania" attachedToRef="Task_PrepareShipment">
        <bpmn:compensateEventDefinition id="CompensateDef_Prepare" />
      </bpmn:boundaryEvent>
      <bpmn:startEvent id="Start_Transaction" name="Początek transakcji">
        <bpmn:outgoing>Flow_TxToPrepare</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_TxToPrepare" sourceRef="Start_Transaction" targetRef="Task_PrepareShipment" />
      <bpmn:association id="Association_Ship" associationDirection="One" sourceRef="BoundaryCompensation_Ship" targetRef="Task_UndoShip" />
      <bpmn:association id="Association_0g21rgq" associationDirection="One" sourceRef="BoundaryCompensation_Prepare" targetRef="Task_UndoPrepare" />
    </bpmn:transaction>
    <bpmn:endEvent id="EndEvent_TxError" name="Zamówienie nieudane&#10;(błąd wysyłki)">
      <bpmn:incoming>Flow_ErrorTxToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ErrorTxToEnd" sourceRef="Task_HandleErrorTx" targetRef="EndEvent_TxError" />
    <bpmn:serviceTask id="Task_HandleCancelledTx" name="Obsługa anulowanej transakcji&#10;(powiadomienie + cofnięcie)" flowable:type="external" flowable:topic="handle-cancelled-transaction">
      <bpmn:incoming>Flow_TxCancelToCompensate</bpmn:incoming>
      <bpmn:outgoing>Flow_07p3wsx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TxCancelToCompensate" sourceRef="BoundaryEvent_TxCancel" targetRef="Task_HandleCancelledTx" />
    <bpmn:endEvent id="EndEvent_TxCancelled" name="Wysyłka anulowana&#10;(zadania cofnięte)">
      <bpmn:incoming>Flow_07p3wsx</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_07p3wsx" sourceRef="Task_HandleCancelledTx" targetRef="EndEvent_TxCancelled" />
    <bpmn:endEvent id="EndEvent_CancelTimeout" name="Zamówienie anulowane&#10;(timeout)">
      <bpmn:incoming>Flow_ToEndCancelTimeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_Timer" name="Termin upłynął&#10;(data transportu)">
      <bpmn:incoming>Flow_ToTimerEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerToCancel</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_Deadline">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${estimatedTransportDate}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_TimerToCancel" sourceRef="Event_Timer" targetRef="Task_CancelTimeout" />
    <bpmn:serviceTask id="Task_CancelTimeout" name="Anulowanie zamówienia&#10;(brak płatności w terminie)" flowable:type="external" flowable:topic="cancel-order">
      <bpmn:incoming>Flow_TimerToCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndCancelTimeout</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEndCancelTimeout" sourceRef="Task_CancelTimeout" targetRef="EndEvent_CancelTimeout" />
    <bpmn:sequenceFlow id="Flow_TransactionToNotify" sourceRef="Transaction_Shipment" targetRef="Task_NotifyDelivery" />
    <bpmn:exclusiveGateway id="Gateway_PaymentValid" name="Czy płatność prawidłowa?">
      <bpmn:incoming>Flow_ToPaymentCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentInvalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentValid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_PaymentInvalid" name="Nie" sourceRef="Gateway_PaymentValid" targetRef="Task_CancelInvalidPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentValid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentValid" name="Tak" sourceRef="Gateway_PaymentValid" targetRef="Transaction_Shipment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="Event_PaymentReceived" name="Płatność otrzymana">
      <bpmn:incoming>Flow_ToPaymentMessage</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaymentCheck</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Payment" messageRef="Message_Payment" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToPaymentCheck" sourceRef="Event_PaymentReceived" targetRef="Gateway_PaymentValid" />
    <bpmn:eventBasedGateway id="Gateway_EventBased" name="Oczekiwanie na płatność">
      <bpmn:incoming>Flow_ToEventGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaymentMessage</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToTimerEvent</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_ToPaymentMessage" sourceRef="Gateway_EventBased" targetRef="Event_PaymentReceived" />
    <bpmn:sequenceFlow id="Flow_ToTimerEvent" sourceRef="Gateway_EventBased" targetRef="Event_Timer" />
    <bpmn:sendTask id="Task_SendQuote" name="Wysłanie wyceny do klienta&#10;(email)" flowable:type="mail">
      <bpmn:extensionElements>
        <flowable:field name="to">
          <flowable:expression>${customerEmail}</flowable:expression>
        </flowable:field>
        <flowable:field name="subject">
          <flowable:string>Wycena zamówienia nr ${orderId}</flowable:string>
        </flowable:field>
        <flowable:field name="text">
          <flowable:expression>Szanowny Kliencie, przesyłamy wycenę zamówienia nr ${orderId}. Kwota: ${totalPrice} PLN. Termin płatności: ${paymentDeadline}.</flowable:expression>
        </flowable:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSendQuote</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEventGateway</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_ToEventGateway" sourceRef="Task_SendQuote" targetRef="Gateway_EventBased" />
    <bpmn:serviceTask id="Task_CalculatePrice" name="Wycena zamówienia&#10;(produkty + transport)" flowable:type="external" flowable:topic="calculate-price">
      <bpmn:incoming>Flow_ToCalculatePrice</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendQuote</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSendQuote" sourceRef="Task_CalculatePrice" targetRef="Task_SendQuote" />
    <bpmn:exclusiveGateway id="Gateway_Merge" name="Scalenie ścieżek">
      <bpmn:incoming>Flow_EstimateToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_DeliveryToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCalculatePrice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToCalculatePrice" sourceRef="Gateway_Merge" targetRef="Task_CalculatePrice" />
    <bpmn:serviceTask id="Task_EstimateTransportDate" name="Szacowanie daty transportu&#10;(data wyjazdu, data dostarczenia)" flowable:type="external" flowable:topic="estimate-transport-date">
      <bpmn:incoming>Flow_ToEstimateDate</bpmn:incoming>
      <bpmn:outgoing>Flow_EstimateToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EstimateToMerge" sourceRef="Task_EstimateTransportDate" targetRef="Gateway_Merge" />
    <bpmn:serviceTask id="Task_StartProduction" name="Rozpoczęcie produkcji brakujących towarów" flowable:type="external" flowable:topic="start-production">
      <bpmn:incoming>Flow_NotAllInStock</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEstimateDate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEstimateDate" sourceRef="Task_StartProduction" targetRef="Task_EstimateTransportDate" />
    <bpmn:serviceTask id="Task_DefineDeliveryTime" name="Określenie czasu dostawy&#10;(data wyjazdu, data dostarczenia)" flowable:type="external" flowable:topic="define-delivery-time">
      <bpmn:incoming>Flow_AllInStock</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliveryToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DeliveryToMerge" sourceRef="Task_DefineDeliveryTime" targetRef="Gateway_Merge" />
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Czy wszystkie towary dostępne?">
      <bpmn:incoming>Flow_ToStockGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_NotAllInStock</bpmn:outgoing>
      <bpmn:outgoing>Flow_AllInStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_NotAllInStock" name="Nie" sourceRef="Gateway_StockCheck" targetRef="Task_StartProduction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allItemsInStock == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AllInStock" name="Tak" sourceRef="Gateway_StockCheck" targetRef="Task_DefineDeliveryTime">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allItemsInStock == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_CheckStock" name="Sprawdzenie dostępności na magazynie" flowable:type="external" flowable:topic="check-stock">
      <bpmn:incoming>Flow_AutoApproveToCheckStock</bpmn:incoming>
      <bpmn:incoming>Flow_ToCheckStock</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStockGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToStockGateway" sourceRef="Task_CheckStock" targetRef="Gateway_StockCheck" />
    <bpmn:serviceTask id="Task_AutoApprove" name="Automatyczne zatwierdzenie&#10;(eskalacja)" flowable:type="external" flowable:topic="auto-approve">
      <bpmn:incoming>Flow_TimerVerifyToEscalation</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApproveToCheckStock</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AutoApproveToCheckStock" sourceRef="Task_AutoApprove" targetRef="Task_CheckStock" />
    <bpmn:userTask id="Task_VerifyOrder" name="Weryfikacja zamówienia" flowable:formKey="verifyOrderForm" flowable:assignee="${initiator}">
      <bpmn:incoming>Flow_ToVerify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCheckStock</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ToCheckStock" sourceRef="Task_VerifyOrder" targetRef="Task_CheckStock" />
    <bpmn:boundaryEvent id="BoundaryTimer_Verify" name="Timeout weryfikacji&#10;(PT20S)" attachedToRef="Task_VerifyOrder">
      <bpmn:outgoing>Flow_TimerVerifyToEscalation</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_BoundaryVerify">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_TimerVerifyToEscalation" sourceRef="BoundaryTimer_Verify" targetRef="Task_AutoApprove" />
    <bpmn:serviceTask id="Task_RegisterOrder" name="Rejestracja zamówienia" flowable:type="external" flowable:topic="register-order">
      <bpmn:incoming>Flow_ToRegister</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVerify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToVerify" sourceRef="Task_RegisterOrder" targetRef="Task_VerifyOrder" />
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Zamówienie otrzymane">
      <bpmn:outgoing>Flow_ToRegister</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Order" messageRef="Message_NewOrder" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRegister" sourceRef="StartEvent_OrderReceived" targetRef="Task_RegisterOrder" />
    <bpmn:sequenceFlow id="Flow_0owb9ry" sourceRef="BoundaryEvent_TxError" targetRef="Task_HandleErrorTx" />
    <bpmn:boundaryEvent id="BoundaryEvent_TxError" name="Błąd wysyłki" attachedToRef="Transaction_Shipment">
      <bpmn:outgoing>Flow_0owb9ry</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDef_Tx" errorRef="Error_ShipmentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_TxCancel" name="Anulowanie transakcji&#10;(cancel)" attachedToRef="Transaction_Shipment">
      <bpmn:outgoing>Flow_TxCancelToCompensate</bpmn:outgoing>
      <bpmn:cancelEventDefinition id="CancelEventDef_Tx" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_CancelInvalidPayment" name="Anulowanie przygotowań&#10;(płatność nieprawidłowa)" flowable:type="external" flowable:topic="cancel-order">
      <bpmn:incoming>Flow_PaymentInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndCancelPayment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_CancelPayment" name="Zamówienie anulowane&#10;(płatność)">
      <bpmn:incoming>Flow_ToEndCancelPayment</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEndCancelPayment" sourceRef="Task_CancelInvalidPayment" targetRef="EndEvent_CancelPayment" />
    <bpmn:endEvent id="EndEvent_Success" name="Zamówienie zrealizowane">
      <bpmn:incoming>Flow_ToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyDelivery" name="Powiadomienie klienta o wysyłce&#10;(email)" flowable:type="mail">
      <bpmn:extensionElements>
        <flowable:field name="to">
          <flowable:expression>${customerEmail}</flowable:expression>
        </flowable:field>
        <flowable:field name="subject">
          <flowable:string>Wysyłka zamówienia nr ${orderId}</flowable:string>
        </flowable:field>
        <flowable:field name="text">
          <flowable:expression>Szanowny Kliencie, Twoje zamówienie nr ${orderId} zostało wysłane. Przewidywana data dostawy: ${deliveryDate}.</flowable:expression>
        </flowable:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TransactionToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndSuccess</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_ToEndSuccess" sourceRef="Task_NotifyDelivery" targetRef="EndEvent_Success" />
    <bpmn:serviceTask id="Task_HandleErrorTx" name="Obsługa błędu wysyłki&#10;(logowanie + powiadomienie)" flowable:type="external" flowable:topic="handle-shipment-error">
      <bpmn:incoming>Flow_0owb9ry</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrorTxToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
